<Window x:Class="LibraSmartWPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:LibraSmartWPF.ViewModels"
        Title="LibraSmart - Библиотечная система"
        Height="800"
        Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <materialDesign:DrawerHost IsLeftDrawerOpen="{Binding ElementName=MenuToggleButton, Path=IsChecked}">
        <!-- Боковое меню -->
        <materialDesign:DrawerHost.LeftDrawerContent>
            <DockPanel Width="260">
                <!-- Заголовок меню -->
                <Border DockPanel.Dock="Top"
                       Background="{DynamicResource MaterialDesign.Brush.Primary}"
                       Padding="16"
                       Height="120">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="Library"
                                                    Width="32"
                                                    Height="32"
                                                    Foreground="White"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,12,0"/>
                            <TextBlock Text="LibraSmart"
                                      FontSize="24"
                                      FontWeight="Bold"
                                      Foreground="White"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding CurrentUserName}"
                                  FontSize="14"
                                  Foreground="White"
                                  FontWeight="Medium"/>
                        <TextBlock Text="{Binding CurrentUserRole}"
                                  FontSize="12"
                                  Foreground="White"
                                  Opacity="0.8"/>
                    </StackPanel>
                </Border>

                <!-- Меню навигации -->
                <ListBox x:Name="MenuListBox"
                        SelectionChanged="MenuListBox_SelectionChanged"
                        Style="{StaticResource MaterialDesignNavigationListBox}">
                    <!-- Меню для читателей -->
                    <ListBoxItem x:Name="CatalogMenuItem"
                                Visibility="{Binding IsReader, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="BookOpenPageVariant" Width="24" Height="24" Margin="0,0,12,0"/>
                            <TextBlock Text="Каталог книг" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="MyLoansMenuItem"
                                Visibility="{Binding IsReader, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="BookClock" Width="24" Height="24" Margin="0,0,12,0"/>
                            <TextBlock Text="Мои займы" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="MyReservationsMenuItem"
                                Visibility="{Binding IsReader, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="BookmarkCheck" Width="24" Height="24" Margin="0,0,12,0"/>
                            <TextBlock Text="Мои бронирования" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="HistoryMenuItem"
                                Visibility="{Binding IsReader, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="History" Width="24" Height="24" Margin="0,0,12,0"/>
                            <TextBlock Text="История" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="ProfileMenuItem"
                                Visibility="{Binding IsReader, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Account" Width="24" Height="24" Margin="0,0,12,0"/>
                            <TextBlock Text="Мой профиль" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>

                    <!-- Меню для персонала -->
                    <ListBoxItem x:Name="BooksManagementMenuItem"
                                Visibility="{Binding IsStaff, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="BookMultiple" Width="24" Height="24" Margin="0,0,12,0"/>
                            <TextBlock Text="Управление книгами" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="LoansManagementMenuItem"
                                Visibility="{Binding IsStaff, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="BookSync" Width="24" Height="24" Margin="0,0,12,0"/>
                            <TextBlock Text="Управление займами" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="ReadersManagementMenuItem"
                                Visibility="{Binding IsStaff, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountMultiple" Width="24" Height="24" Margin="0,0,12,0"/>
                            <TextBlock Text="Управление читателями" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="LibrariesMenuItem"
                                Visibility="{Binding IsStaff, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Domain" Width="24" Height="24" Margin="0,0,12,0"/>
                            <TextBlock Text="Библиотеки" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <!-- Кнопка выхода -->
                <Button DockPanel.Dock="Bottom"
                       Command="{Binding LogoutCommand}"
                       Style="{StaticResource MaterialDesignFlatButton}"
                       Margin="16"
                       HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Logout" Width="24" Height="24" Margin="0,0,8,0"/>
                        <TextBlock Text="Выход" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </DockPanel>
        </materialDesign:DrawerHost.LeftDrawerContent>

        <!-- Основной контент -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель -->
            <materialDesign:ColorZone Mode="PrimaryMid"
                                     Padding="16"
                                     Grid.Row="0"
                                     materialDesign:ElevationAssist.Elevation="Dp4">
                <DockPanel>
                    <ToggleButton x:Name="MenuToggleButton"
                                 Style="{StaticResource MaterialDesignHamburgerToggleButton}"
                                 DockPanel.Dock="Left"
                                 Margin="0,0,16,0"/>
                    <TextBlock Text="LibraSmart - Библиотечная система управления"
                              FontSize="20"
                              FontWeight="Medium"
                              VerticalAlignment="Center"/>
                </DockPanel>
            </materialDesign:ColorZone>

            <!-- Контент-область -->
            <Frame x:Name="ContentFrame"
                  Grid.Row="1"
                  NavigationUIVisibility="Hidden"
                  Background="{DynamicResource MaterialDesign.Brush.Background}"/>
        </Grid>
    </materialDesign:DrawerHost>
</Window>
