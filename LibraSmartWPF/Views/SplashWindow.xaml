<Window x:Class="LibraSmartWPF.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="LibraSmart"
        Height="300"
        Width="500"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True">

    <Border Background="{DynamicResource MaterialDesign.Brush.Background}"
            CornerRadius="10"
            BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
            BorderThickness="2"
            materialDesign:ElevationAssist.Elevation="Dp8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.Row="0"
                       HorizontalAlignment="Center"
                       Margin="0,40,0,0">
                <materialDesign:PackIcon Kind="Library"
                                        Width="64"
                                        Height="64"
                                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                        HorizontalAlignment="Center"/>
                <TextBlock Text="LibraSmart"
                          FontSize="32"
                          FontWeight="Bold"
                          HorizontalAlignment="Center"
                          Margin="0,16,0,0"
                          Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
            </StackPanel>

            <!-- Индикатор загрузки -->
            <StackPanel Grid.Row="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                            Value="0"
                            IsIndeterminate="True"
                            Width="48"
                            Height="48"
                            Margin="0,0,0,16"/>
                <TextBlock Text="Инициализация базы данных..."
                          FontSize="14"
                          HorizontalAlignment="Center"
                          Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
            </StackPanel>

            <!-- Версия -->
            <TextBlock Grid.Row="2"
                      Text="Версия 1.0.0"
                      FontSize="10"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,16"
                      Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"/>
        </Grid>
    </Border>
</Window>
