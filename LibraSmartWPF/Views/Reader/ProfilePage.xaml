<Page x:Class="LibraSmartWPF.Views.Reader.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:viewmodels="clr-namespace:LibraSmartWPF.ViewModels"
      Title="ProfilePage">

    <Page.DataContext>
        <viewmodels:ProfileViewModel />
    </Page.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24" MaxWidth="800">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Text="Мой профиль"
                      Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                      Margin="0,0,0,24"/>

            <!-- Статистика -->
            <materialDesign:Card Grid.Row="1" Margin="0,0,0,24" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="BookOpenPageVariant"
                                               Width="48"
                                               Height="48"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBlock Text="{Binding TotalLoans}"
                                  Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                                  HorizontalAlignment="Center"
                                  Margin="0,8,0,0"/>
                        <TextBlock Text="Всего займов"
                                  Style="{StaticResource MaterialDesignBody2TextBlock}"
                                  HorizontalAlignment="Center"
                                  Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="BookClock"
                                               Width="48"
                                               Height="48"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryHueMidBrush}"/>
                        <TextBlock Text="{Binding ActiveLoans}"
                                  Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                                  HorizontalAlignment="Center"
                                  Margin="0,8,0,0"/>
                        <TextBlock Text="Активных займов"
                                  Style="{StaticResource MaterialDesignBody2TextBlock}"
                                  HorizontalAlignment="Center"
                                  Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="BookmarkMultiple"
                                               Width="48"
                                               Height="48"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBlock Text="{Binding TotalReservations}"
                                  Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                                  HorizontalAlignment="Center"
                                  Margin="0,8,0,0"/>
                        <TextBlock Text="Всего бронирований"
                                  Style="{StaticResource MaterialDesignBody2TextBlock}"
                                  HorizontalAlignment="Center"
                                  Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="BookmarkCheck"
                                               Width="48"
                                               Height="48"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryHueMidBrush}"/>
                        <TextBlock Text="{Binding ActiveReservations}"
                                  Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                                  HorizontalAlignment="Center"
                                  Margin="0,8,0,0"/>
                        <TextBlock Text="Активных бронирований"
                                  Style="{StaticResource MaterialDesignBody2TextBlock}"
                                  HorizontalAlignment="Center"
                                  Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- Личные данные -->
            <materialDesign:Card Grid.Row="2" Margin="0,0,0,24" Padding="24">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Личные данные"
                                  Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>
                        <Button Command="{Binding EditProfileCommand}"
                               Style="{StaticResource MaterialDesignOutlinedButton}"
                               HorizontalAlignment="Right"
                               Visibility="{Binding IsEditMode, Converter={StaticResource InverseBooleanConverter}, ConverterParameter=Visibility}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Pencil" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Редактировать" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Separator Margin="0,0,0,16"/>

                    <!-- Режим просмотра -->
                    <Grid Visibility="{Binding IsEditMode, Converter={StaticResource InverseBooleanConverter}, ConverterParameter=Visibility}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="ФИО:" Style="{StaticResource MaterialDesignBody1TextBlock}" Margin="0,0,0,16"/>
                        <TextBlock Grid.Column="1" Text="{Binding FullName}" Style="{StaticResource MaterialDesignBody1TextBlock}" Margin="0,0,0,16"/>

                        <TextBlock Grid.Row="1" Text="Email:" Style="{StaticResource MaterialDesignBody1TextBlock}" Margin="0,0,0,16"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Email}" Style="{StaticResource MaterialDesignBody1TextBlock}" Margin="0,0,0,16"/>

                        <TextBlock Grid.Row="2" Text="Телефон:" Style="{StaticResource MaterialDesignBody1TextBlock}" Margin="0,0,0,16"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Phone}" Style="{StaticResource MaterialDesignBody1TextBlock}" Margin="0,0,0,16"/>

                        <TextBlock Grid.Row="3" Text="Номер билета:" Style="{StaticResource MaterialDesignBody1TextBlock}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LibraryCardNumber}" Style="{StaticResource MaterialDesignBody1TextBlock}"/>
                    </Grid>

                    <!-- Режим редактирования -->
                    <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBox materialDesign:HintAssist.Hint="ФИО *"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,0,16"
                                FontSize="14"/>

                        <TextBox materialDesign:HintAssist.Hint="Email *"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,0,16"
                                FontSize="14"/>

                        <TextBox materialDesign:HintAssist.Hint="Телефон"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,0,16"
                                FontSize="14"/>

                        <TextBox materialDesign:HintAssist.Hint="Номер билета"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding LibraryCardNumber}"
                                IsReadOnly="True"
                                Margin="0,0,0,16"
                                FontSize="14"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding CancelEditCommand}"
                                   Style="{StaticResource MaterialDesignOutlinedButton}"
                                   Content="Отмена"
                                   Margin="0,0,8,0"/>
                            <Button Command="{Binding SaveProfileCommand}"
                                   Style="{StaticResource MaterialDesignRaisedButton}"
                                   Content="Сохранить"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- Смена пароля -->
            <materialDesign:Card Grid.Row="3" Padding="24">
                <StackPanel>
                    <TextBlock Text="Смена пароля"
                              Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                              Margin="0,0,0,16"/>

                    <Separator Margin="0,0,0,16"/>

                    <PasswordBox x:Name="CurrentPasswordBox"
                                materialDesign:HintAssist.Hint="Текущий пароль"
                                Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                Margin="0,0,0,16"
                                FontSize="14"
                                PasswordChanged="CurrentPasswordBox_PasswordChanged"/>

                    <PasswordBox x:Name="NewPasswordBox"
                                materialDesign:HintAssist.Hint="Новый пароль"
                                Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                Margin="0,0,0,16"
                                FontSize="14"
                                PasswordChanged="NewPasswordBox_PasswordChanged"/>

                    <PasswordBox x:Name="ConfirmPasswordBox"
                                materialDesign:HintAssist.Hint="Подтвердите новый пароль"
                                Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                Margin="0,0,0,16"
                                FontSize="14"
                                PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>

                    <Button Command="{Binding ChangePasswordCommand}"
                           Style="{StaticResource MaterialDesignRaisedButton}"
                           Content="Изменить пароль"
                           HorizontalAlignment="Right"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </ScrollViewer>
</Page>
