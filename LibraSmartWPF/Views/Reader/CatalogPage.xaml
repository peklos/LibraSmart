<Page x:Class="LibraSmartWPF.Views.Reader.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:viewmodels="clr-namespace:LibraSmartWPF.ViewModels"
      Title="CatalogPage">

    <Page.DataContext>
        <viewmodels:CatalogViewModel />
    </Page.DataContext>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="Каталог книг"
                  Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                  Margin="0,0,0,24"/>

        <!-- Поиск -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox materialDesign:HintAssist.Hint="Поиск по названию, автору или жанру"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    FontSize="14">
                <materialDesign:TextFieldAssist.LeadingIcon>
                    <materialDesign:PackIcon Kind="Magnify"/>
                </materialDesign:TextFieldAssist.LeadingIcon>
            </TextBox>

            <Button Grid.Column="1"
                   Command="{Binding RefreshCommand}"
                   Style="{StaticResource MaterialDesignIconButton}"
                   Margin="8,0,0,0"
                   ToolTip="Обновить">
                <materialDesign:PackIcon Kind="Refresh" Width="24" Height="24"/>
            </Button>
        </Grid>

        <!-- Список книг -->
        <materialDesign:Card Grid.Row="2">
            <Grid>
                <!-- Индикатор загрузки -->
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                            Value="0"
                            IsIndeterminate="True"
                            Width="50"
                            Height="50"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- DataGrid с книгами -->
                <DataGrid ItemsSource="{Binding Books}"
                         SelectedItem="{Binding SelectedBook}"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         CanUserDeleteRows="False"
                         IsReadOnly="True"
                         SelectionMode="Single"
                         materialDesign:DataGridAssist.CellPadding="8"
                         materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название"
                                          Binding="{Binding Title}"
                                          Width="*"
                                          MinWidth="200"/>
                        <DataGridTextColumn Header="Автор"
                                          Binding="{Binding Author}"
                                          Width="*"
                                          MinWidth="150"/>
                        <DataGridTextColumn Header="Год"
                                          Binding="{Binding PublicationYear}"
                                          Width="80"/>
                        <DataGridTextColumn Header="Жанр"
                                          Binding="{Binding GenreName}"
                                          Width="150"/>
                        <DataGridTextColumn Header="Доступно"
                                          Binding="{Binding AvailableCopies}"
                                          Width="100"/>
                        <DataGridTextColumn Header="Всего"
                                          Binding="{Binding TotalCopies}"
                                          Width="80"/>
                        <DataGridTemplateColumn Header="Действия" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.ReserveCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                           Style="{StaticResource MaterialDesignRaisedButton}"
                                           Content="Забронировать"
                                           Height="32"
                                           Padding="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Page>
