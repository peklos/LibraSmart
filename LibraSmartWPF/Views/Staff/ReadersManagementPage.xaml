<Page x:Class="LibraSmartWPF.Views.Staff.ReadersManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:viewmodels="clr-namespace:LibraSmartWPF.ViewModels"
      Title="ReadersManagementPage">

    <Page.DataContext>
        <viewmodels:ReadersManagementViewModel />
    </Page.DataContext>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="Управление читателями"
                  Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                  Margin="0,0,0,24"/>

        <!-- Поиск и кнопки -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox materialDesign:HintAssist.Hint="Поиск по ФИО, email, номеру билета или телефону"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    FontSize="14">
                <materialDesign:TextFieldAssist.LeadingIcon>
                    <materialDesign:PackIcon Kind="Magnify"/>
                </materialDesign:TextFieldAssist.LeadingIcon>
            </TextBox>

            <Button Grid.Column="1"
                   Command="{Binding ViewReaderDetailsCommand}"
                   Style="{StaticResource MaterialDesignOutlinedButton}"
                   Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AccountDetails"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                    <TextBlock Text="Подробная информация" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="2"
                   Command="{Binding RefreshCommand}"
                   Style="{StaticResource MaterialDesignIconButton}"
                   Margin="8,0,0,0"
                   ToolTip="Обновить">
                <materialDesign:PackIcon Kind="Refresh" Width="24" Height="24"/>
            </Button>
        </Grid>

        <!-- Список читателей -->
        <materialDesign:Card Grid.Row="2">
            <Grid>
                <!-- Индикатор загрузки -->
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                            Value="0"
                            IsIndeterminate="True"
                            Width="50"
                            Height="50"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- DataGrid с читателями -->
                <DataGrid ItemsSource="{Binding Readers}"
                         SelectedItem="{Binding SelectedReader}"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         CanUserDeleteRows="False"
                         IsReadOnly="True"
                         SelectionMode="Single"
                         materialDesign:DataGridAssist.CellPadding="8"
                         materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ФИО"
                                          Binding="{Binding FullName}"
                                          Width="*"
                                          MinWidth="200"/>
                        <DataGridTextColumn Header="Email"
                                          Binding="{Binding Email}"
                                          Width="*"
                                          MinWidth="180"/>
                        <DataGridTextColumn Header="Телефон"
                                          Binding="{Binding Phone}"
                                          Width="140"/>
                        <DataGridTextColumn Header="Номер билета"
                                          Binding="{Binding LibraryCardNumber}"
                                          Width="130"/>
                        <DataGridTextColumn Header="Дата регистрации"
                                          Binding="{Binding CreatedAt, StringFormat='dd.MM.yyyy'}"
                                          Width="140"/>
                        <DataGridTextColumn Header="Активных займов"
                                          Binding="{Binding ActiveLoans}"
                                          Width="130"/>
                        <DataGridTextColumn Header="Всего займов"
                                          Binding="{Binding TotalLoans}"
                                          Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Page>
