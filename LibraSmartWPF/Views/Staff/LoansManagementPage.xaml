<Page x:Class="LibraSmartWPF.Views.Staff.LoansManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:viewmodels="clr-namespace:LibraSmartWPF.ViewModels"
      Title="LoansManagementPage">

    <Page.DataContext>
        <viewmodels:LoansManagementViewModel />
    </Page.DataContext>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="Управление займами"
                  Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                  Margin="0,0,0,24"/>

        <!-- Поиск и фильтры -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Строка поиска -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox materialDesign:HintAssist.Hint="Поиск по читателю или книге"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    FontSize="14">
                <materialDesign:TextFieldAssist.LeadingIcon>
                    <materialDesign:PackIcon Kind="Magnify"/>
                </materialDesign:TextFieldAssist.LeadingIcon>
            </TextBox>

            <StackPanel Grid.Column="1"
                       Orientation="Horizontal"
                       Margin="8,0,0,0">
                <Button Command="{Binding ReturnBookCommand}"
                       Style="{StaticResource MaterialDesignRaisedButton}"
                       Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="BookCheck"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                        <TextBlock Text="Вернуть книгу" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding RefreshCommand}"
                       Style="{StaticResource MaterialDesignIconButton}"
                       ToolTip="Обновить">
                    <materialDesign:PackIcon Kind="Refresh" Width="24" Height="24"/>
                </Button>
            </StackPanel>

            <!-- Фильтры -->
            <StackPanel Grid.Row="1"
                       Orientation="Horizontal"
                       Margin="0,16,0,0">
                <TextBlock Text="Фильтр:"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"
                          FontWeight="Medium"/>

                <RadioButton Content="Активные"
                            GroupName="StatusFilter"
                            IsChecked="True"
                            Style="{StaticResource MaterialDesignTabRadioButton}"
                            Margin="0,0,8,0"
                            Checked="ActiveFilter_Checked"/>

                <RadioButton Content="Просроченные"
                            GroupName="StatusFilter"
                            Style="{StaticResource MaterialDesignTabRadioButton}"
                            Margin="0,0,8,0"
                            Checked="OverdueFilter_Checked"/>

                <RadioButton Content="Возвращённые"
                            GroupName="StatusFilter"
                            Style="{StaticResource MaterialDesignTabRadioButton}"
                            Margin="0,0,8,0"
                            Checked="ReturnedFilter_Checked"/>

                <RadioButton Content="Все"
                            GroupName="StatusFilter"
                            Style="{StaticResource MaterialDesignTabRadioButton}"
                            Margin="0,0,8,0"
                            Checked="AllFilter_Checked"/>
            </StackPanel>
        </Grid>

        <!-- Список займов -->
        <materialDesign:Card Grid.Row="2">
            <Grid>
                <!-- Индикатор загрузки -->
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                            Value="0"
                            IsIndeterminate="True"
                            Width="50"
                            Height="50"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- DataGrid с займами -->
                <DataGrid ItemsSource="{Binding Loans}"
                         SelectedItem="{Binding SelectedLoan}"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         CanUserDeleteRows="False"
                         IsReadOnly="True"
                         SelectionMode="Single"
                         materialDesign:DataGridAssist.CellPadding="8"
                         materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Читатель"
                                          Binding="{Binding ReaderName}"
                                          Width="*"
                                          MinWidth="150"/>
                        <DataGridTextColumn Header="Email"
                                          Binding="{Binding ReaderEmail}"
                                          Width="*"
                                          MinWidth="150"/>
                        <DataGridTextColumn Header="Книга"
                                          Binding="{Binding BookTitle}"
                                          Width="*"
                                          MinWidth="200"/>
                        <DataGridTextColumn Header="Автор"
                                          Binding="{Binding BookAuthor}"
                                          Width="*"
                                          MinWidth="150"/>
                        <DataGridTextColumn Header="Дата выдачи"
                                          Binding="{Binding LoanDate, StringFormat='dd.MM.yyyy'}"
                                          Width="110"/>
                        <DataGridTextColumn Header="Срок возврата"
                                          Binding="{Binding DueDate, StringFormat='dd.MM.yyyy'}"
                                          Width="110"/>
                        <DataGridTextColumn Header="Дата возврата"
                                          Binding="{Binding ReturnDate, StringFormat='dd.MM.yyyy'}"
                                          Width="110"/>
                        <DataGridTextColumn Header="Статус"
                                          Binding="{Binding StatusDisplay}"
                                          Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Page>
