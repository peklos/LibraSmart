<Page x:Class="LibraSmartWPF.Views.Staff.BooksManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:viewmodels="clr-namespace:LibraSmartWPF.ViewModels"
      Title="BooksManagementPage">

    <Page.DataContext>
        <viewmodels:BooksManagementViewModel />
    </Page.DataContext>

    <Grid Margin="24">
        <!-- Режим просмотра списка -->
        <Grid Visibility="{Binding IsEditMode, Converter={StaticResource InverseBooleanConverter}, ConverterParameter=Visibility}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Text="Управление книгами"
                      Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                      Margin="0,0,0,24"/>

            <!-- Поиск и кнопки -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox materialDesign:HintAssist.Hint="Поиск по названию, автору или жанру"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        FontSize="14">
                    <materialDesign:TextFieldAssist.LeadingIcon>
                        <materialDesign:PackIcon Kind="Magnify"/>
                    </materialDesign:TextFieldAssist.LeadingIcon>
                </TextBox>

                <Button Grid.Column="1"
                       Command="{Binding AddBookCommand}"
                       Style="{StaticResource MaterialDesignRaisedButton}"
                       Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Добавить" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                       Command="{Binding EditBookCommand}"
                       Style="{StaticResource MaterialDesignOutlinedButton}"
                       Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Pencil" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Редактировать" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="3"
                       Command="{Binding DeleteBookCommand}"
                       Style="{StaticResource MaterialDesignOutlinedButton}"
                       Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                       Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Delete" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Удалить" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="4"
                       Command="{Binding RefreshCommand}"
                       Style="{StaticResource MaterialDesignIconButton}"
                       Margin="8,0,0,0"
                       ToolTip="Обновить">
                    <materialDesign:PackIcon Kind="Refresh" Width="24" Height="24"/>
                </Button>
            </Grid>

            <!-- Список книг -->
            <materialDesign:Card Grid.Row="2">
                <Grid>
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                Value="0"
                                IsIndeterminate="True"
                                Width="50"
                                Height="50"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <DataGrid ItemsSource="{Binding Books}"
                             SelectedItem="{Binding SelectedBook}"
                             AutoGenerateColumns="False"
                             CanUserAddRows="False"
                             CanUserDeleteRows="False"
                             IsReadOnly="True"
                             SelectionMode="Single"
                             materialDesign:DataGridAssist.CellPadding="8"
                             materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название"
                                              Binding="{Binding Title}"
                                              Width="*"
                                              MinWidth="200"/>
                            <DataGridTextColumn Header="Автор"
                                              Binding="{Binding Author}"
                                              Width="*"
                                              MinWidth="150"/>
                            <DataGridTextColumn Header="Год"
                                              Binding="{Binding PublicationYear}"
                                              Width="80"/>
                            <DataGridTextColumn Header="Жанр"
                                              Binding="{Binding GenreName}"
                                              Width="150"/>
                            <DataGridTextColumn Header="ISBN"
                                              Binding="{Binding ISBN}"
                                              Width="120"/>
                            <DataGridTextColumn Header="Экземпляров"
                                              Binding="{Binding CopiesCount}"
                                              Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- Режим редактирования/добавления -->
        <Grid Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <materialDesign:Card Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="600">
                        <!-- Заголовок -->
                        <TextBlock Text="{Binding SelectedBook, ConverterParameter='Редактирование книги|Добавление книги', Converter={StaticResource NullToStringConverter}}"
                                  Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                  Margin="0,0,0,24"/>

                        <!-- Название -->
                        <TextBox materialDesign:HintAssist.Hint="Название книги *"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,0,16"
                                FontSize="14"/>

                        <!-- Автор -->
                        <TextBox materialDesign:HintAssist.Hint="Автор *"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding EditAuthor, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,0,16"
                                FontSize="14"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Год издания -->
                            <TextBox materialDesign:HintAssist.Hint="Год издания"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding EditPublicationYear, UpdateSourceTrigger=PropertyChanged}"
                                    FontSize="14"/>

                            <!-- ISBN -->
                            <TextBox Grid.Column="2"
                                    materialDesign:HintAssist.Hint="ISBN"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding EditISBN, UpdateSourceTrigger=PropertyChanged}"
                                    FontSize="14"/>
                        </Grid>

                        <!-- Жанр -->
                        <ComboBox materialDesign:HintAssist.Hint="Жанр *"
                                 Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                 ItemsSource="{Binding Genres}"
                                 SelectedItem="{Binding EditSelectedGenre}"
                                 DisplayMemberPath="GenreName"
                                 Margin="0,0,0,16"
                                 FontSize="14"/>

                        <!-- Описание -->
                        <TextBox materialDesign:HintAssist.Hint="Описание"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                MinHeight="100"
                                VerticalScrollBarVisibility="Auto"
                                Margin="0,0,0,24"
                                FontSize="14"/>

                        <!-- Кнопки -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding CancelEditCommand}"
                                   Style="{StaticResource MaterialDesignOutlinedButton}"
                                   Content="Отмена"
                                   Margin="0,0,8,0"/>
                            <Button Command="{Binding SaveBookCommand}"
                                   Style="{StaticResource MaterialDesignRaisedButton}"
                                   Content="Сохранить"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Page>
