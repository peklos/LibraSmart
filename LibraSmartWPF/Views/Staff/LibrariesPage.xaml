<Page x:Class="LibraSmartWPF.Views.Staff.LibrariesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:viewmodels="clr-namespace:LibraSmartWPF.ViewModels"
      Title="LibrariesPage">

    <Page.DataContext>
        <viewmodels:LibrariesViewModel />
    </Page.DataContext>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="Библиотеки"
                  Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                  Margin="0,0,0,24"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="1"
                   Orientation="Horizontal"
                   Margin="0,0,0,16">
            <Button Command="{Binding ViewLibraryDetailsCommand}"
                   Style="{StaticResource MaterialDesignOutlinedButton}"
                   Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="InformationOutline"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                    <TextBlock Text="Подробная информация" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Command="{Binding RefreshCommand}"
                   Style="{StaticResource MaterialDesignIconButton}"
                   ToolTip="Обновить">
                <materialDesign:PackIcon Kind="Refresh" Width="24" Height="24"/>
            </Button>
        </StackPanel>

        <!-- Список библиотек -->
        <materialDesign:Card Grid.Row="2">
            <Grid>
                <!-- Индикатор загрузки -->
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                            Value="0"
                            IsIndeterminate="True"
                            Width="50"
                            Height="50"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- DataGrid с библиотеками -->
                <DataGrid ItemsSource="{Binding Libraries}"
                         SelectedItem="{Binding SelectedLibrary}"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         CanUserDeleteRows="False"
                         IsReadOnly="True"
                         SelectionMode="Single"
                         materialDesign:DataGridAssist.CellPadding="8"
                         materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название"
                                          Binding="{Binding LibraryName}"
                                          Width="*"
                                          MinWidth="250"/>
                        <DataGridTextColumn Header="Адрес"
                                          Binding="{Binding Address}"
                                          Width="*"
                                          MinWidth="300"/>
                        <DataGridTextColumn Header="Телефон"
                                          Binding="{Binding Phone}"
                                          Width="150"/>
                        <DataGridTextColumn Header="Сотрудников"
                                          Binding="{Binding StaffCount}"
                                          Width="120"/>
                        <DataGridTextColumn Header="Книг"
                                          Binding="{Binding BooksCount}"
                                          Width="100"/>
                        <DataGridTextColumn Header="Активных займов"
                                          Binding="{Binding ActiveLoansCount}"
                                          Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Page>
