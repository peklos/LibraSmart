<Window x:Class="LibraSmartWPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:LibraSmartWPF.ViewModels"
        Title="LibraSmart - Вход в систему"
        Height="600"
        Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Window.DataContext>
        <viewmodels:LoginViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <materialDesign:ColorZone Mode="PrimaryMid"
                                  Padding="16"
                                  Grid.Row="0"
                                  materialDesign:ElevationAssist.Elevation="Dp4">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Library"
                                        Width="32"
                                        Height="32"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,0"/>
                <TextBlock Text="LibraSmart"
                          FontSize="24"
                          FontWeight="Bold"
                          VerticalAlignment="Center"/>
            </StackPanel>
        </materialDesign:ColorZone>

        <!-- Форма входа -->
        <StackPanel Grid.Row="1"
                   VerticalAlignment="Center"
                   Margin="40,0">

            <!-- Заголовок формы -->
            <TextBlock Text="{Binding ModeText}"
                      Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,32"/>

            <!-- Email -->
            <TextBox materialDesign:HintAssist.Hint="Email"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                    Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,0,0,16"
                    FontSize="16">
                <materialDesign:TextFieldAssist.LeadingIcon>
                    <materialDesign:PackIcon Kind="Email"/>
                </materialDesign:TextFieldAssist.LeadingIcon>
            </TextBox>

            <!-- Пароль -->
            <PasswordBox x:Name="PasswordBox"
                        materialDesign:HintAssist.Hint="Пароль"
                        Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                        Margin="0,0,0,16"
                        FontSize="16"
                        PasswordChanged="PasswordBox_PasswordChanged">
                <materialDesign:TextFieldAssist.LeadingIcon>
                    <materialDesign:PackIcon Kind="Lock"/>
                </materialDesign:TextFieldAssist.LeadingIcon>
            </PasswordBox>

            <!-- Сообщение об ошибке -->
            <TextBlock Text="{Binding ErrorMessage}"
                      Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                      Margin="0,0,0,16"
                      TextWrapping="Wrap"
                      HorizontalAlignment="Center"
                      Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>

            <!-- Кнопка входа -->
            <Button Command="{Binding LoginCommand}"
                   Style="{StaticResource MaterialDesignRaisedButton}"
                   Height="48"
                   Margin="0,0,0,16"
                   materialDesign:ButtonAssist.CornerRadius="4">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Login"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                    <TextBlock Text="ВОЙТИ"
                              VerticalAlignment="Center"
                              FontSize="14"
                              FontWeight="Medium"/>
                </StackPanel>
            </Button>

            <!-- Переключение режима -->
            <Button Command="{Binding SwitchModeCommand}"
                   Style="{StaticResource MaterialDesignFlatButton}"
                   Content="{Binding SwitchModeText}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8"/>

            <!-- Регистрация (только для читателей) -->
            <Button Command="{Binding RegisterCommand}"
                   Style="{StaticResource MaterialDesignFlatButton}"
                   Content="Зарегистрироваться"
                   HorizontalAlignment="Center"
                   Visibility="{Binding IsReaderMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- Подсказка с тестовыми данными -->
            <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                   Padding="16"
                   Margin="0,32,0,0"
                   CornerRadius="4"
                   materialDesign:ElevationAssist.Elevation="Dp1">
                <StackPanel>
                    <TextBlock Text="Тестовые учетные данные:"
                              FontWeight="Bold"
                              Margin="0,0,0,8"/>
                    <TextBlock FontSize="12" Margin="0,0,0,4">
                        <Run Text="Читатель:" FontWeight="Medium"/>
                        <LineBreak/>
                        <Run Text="Email: alekseev@mail.ru"/>
                        <LineBreak/>
                        <Run Text="Пароль: reader123"/>
                    </TextBlock>
                    <TextBlock FontSize="12" Margin="0,8,0,0">
                        <Run Text="Персонал:" FontWeight="Medium"/>
                        <LineBreak/>
                        <Run Text="Email: petrova@library.ru"/>
                        <LineBreak/>
                        <Run Text="Пароль: admin123"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
